# Everything below is optional for local development: `npm run dev` works with no .env at all.

APP_URL=http://localhost:3000

# --- Database: unset = embedded Postgres (PGlite) under ECCA_DATA_DIR ---
# DATABASE_URL=postgres://user:pass@host:5432/db
# ECCA_DATA_DIR=.data

# --- Encryption (required in production) ---
# 32 random bytes, base64:  openssl rand -base64 32
# ECCA_MASTER_KEY=
# Ed25519 private key (PKCS8 PEM) that signs evidence records:
#   openssl genpkey -algorithm ed25519
# EVIDENCE_SIGNING_PRIVATE_KEY=
# EVIDENCE_SIGNING_KEY_ID=

# --- Email: outbox (default, nothing is sent; view at /dev/mail) or resend ---
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Passport <no-reply@yourdomain.org>"
# RESEND_API_KEY=

# --- Payments: sandbox (default, no money moves) or stripe ---
# PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Object storage: local (default, encrypted files under ECCA_DATA_DIR) or s3 ---
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Data rail for auto-submit: simulated (default) or plaid ---
# RAIL_PROVIDER=plaid
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# --- Optional model-assisted reading of scanned/photographed documents ---
# ANTHROPIC_API_KEY=

# --- Operations ---
# CRON_SECRET=
# JOBS_INLINE=false
# PLATFORM_ADMIN_EMAILS=you@example.org
